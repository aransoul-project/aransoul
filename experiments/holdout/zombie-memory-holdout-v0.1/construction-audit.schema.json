{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aransoul.example/schemas/zombie-memory-holdout-v0.1-construction-audit.schema.json",
  "title": "Zombie Memory Holdout v0.1 Construction Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slot_id",
    "candidate_version",
    "state",
    "construction_pass",
    "adversarial_review_pass",
    "schema_check",
    "slot_match_check",
    "gold_uniqueness_check",
    "pilot_overlap_check",
    "leakage_check",
    "semantic_equivalence_check",
    "scorer_determinism_check",
    "repair_history",
    "rejection_reason",
    "accepted_reason",
    "target_model_execution_count"
  ],
  "properties": {
    "slot_id": {
      "type": "string",
      "pattern": "^ZH-(0[1-9]|1[0-9]|2[0-4])$"
    },
    "candidate_version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": ["draft", "repair", "rejected", "accepted-pre-freeze"]
    },
    "construction_pass": { "$ref": "#/$defs/reviewPass" },
    "adversarial_review_pass": { "$ref": "#/$defs/reviewPass" },
    "schema_check": { "$ref": "#/$defs/check" },
    "slot_match_check": { "$ref": "#/$defs/check" },
    "gold_uniqueness_check": { "$ref": "#/$defs/check" },
    "pilot_overlap_check": { "$ref": "#/$defs/check" },
    "leakage_check": { "$ref": "#/$defs/check" },
    "semantic_equivalence_check": { "$ref": "#/$defs/check" },
    "scorer_determinism_check": { "$ref": "#/$defs/check" },
    "repair_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version_from", "version_to", "reason", "fields_changed", "triggered_by"],
        "properties": {
          "version_from": { "type": "integer", "minimum": 1 },
          "version_to": { "type": "integer", "minimum": 2 },
          "reason": { "type": "string", "minLength": 1 },
          "fields_changed": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "triggered_by": {
            "enum": [
              "construction_pass",
              "adversarial_review_pass",
              "schema_check",
              "slot_match_check",
              "gold_uniqueness_check",
              "pilot_overlap_check",
              "leakage_check",
              "semantic_equivalence_check",
              "scorer_determinism_check"
            ]
          }
        }
      }
    },
    "rejection_reason": {
      "type": ["string", "null"]
    },
    "accepted_reason": {
      "type": ["string", "null"]
    },
    "target_model_execution_count": {
      "const": 0
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "rejected" } } },
      "then": {
        "properties": {
          "rejection_reason": { "type": "string", "minLength": 1 },
          "accepted_reason": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "accepted-pre-freeze" } } },
      "then": {
        "properties": {
          "accepted_reason": { "type": "string", "minLength": 1 },
          "rejection_reason": { "type": "null" },
          "schema_check": { "properties": { "result": { "const": "pass" } } },
          "slot_match_check": { "properties": { "result": { "const": "pass" } } },
          "gold_uniqueness_check": { "properties": { "result": { "const": "pass" } } },
          "pilot_overlap_check": { "properties": { "result": { "const": "pass" } } },
          "leakage_check": { "properties": { "result": { "const": "pass" } } },
          "semantic_equivalence_check": { "properties": { "result": { "const": "pass" } } }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "enum": ["pass", "fail", "not_run", "not_applicable"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "notes"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "notes": { "type": "string" }
      }
    },
    "reviewPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "notes", "issues_found"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "notes": { "type": "string" },
        "issues_found": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
