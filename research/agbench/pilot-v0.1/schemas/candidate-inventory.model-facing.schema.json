{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark","snapshot","status","release_state","model_facing","gold_included","blind_mapping_included","reviewer_material_included","inventory_summary","cases"],
  "properties": {
    "benchmark": {"const": "AGBench"},
    "snapshot": {"type": "string"},
    "status": {"const": "development_only"},
    "release_state": {"const": "PAUSED_AFTER_STATIC_MEASUREMENT_DESIGN_CLOSURE"},
    "model_facing": {"const": true},
    "gold_included": {"const": false},
    "blind_mapping_included": {"const": false},
    "reviewer_material_included": {"const": false},
    "inventory_summary": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["public_id","track","scenario","available_context"],
        "properties": {
          "public_id": {"type": "string", "pattern": "^AGB-(P|D)[0-9]{2}$"},
          "track": {"enum": ["strict_primary","controlled_scope_diagnostic"]},
          "scenario": {"type": "string", "minLength": 1},
          "available_context": {"type": "object"}
        }
      }
    }
  }
}
