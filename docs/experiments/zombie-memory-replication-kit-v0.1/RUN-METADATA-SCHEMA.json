{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zombie Memory Replication Run Metadata v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replication_title",
    "evidence_label",
    "preregistration_id",
    "source_commit_sha",
    "case_set",
    "execution",
    "separation",
    "run",
    "artifact_paths"
  ],
  "properties": {
    "schema_version": {"const": "zombie-memory-replication-run-metadata-v0.1"},
    "replication_title": {"type": "string", "minLength": 1},
    "evidence_label": {
      "enum": [
        "reproduction",
        "cross-model-reproduction",
        "evaluation-separated-replication",
        "independent-external-replication",
        "cross-environment-generalization-replication"
      ]
    },
    "preregistration_id": {"type": "string", "minLength": 1},
    "source_commit_sha": {"type": "string", "minLength": 7},
    "case_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "path_or_id", "immutable_hash_or_commit", "case_count", "conditions"],
      "properties": {
        "source_type": {"enum": ["original-public", "new-independent", "third-party", "other"]},
        "path_or_id": {"type": "string", "minLength": 1},
        "immutable_hash_or_commit": {"type": "string", "minLength": 1},
        "case_count": {"type": "integer", "minimum": 1},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "temperature", "top_p", "retry_policy", "ordering_policy"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version_or_snapshot": {"type": ["string", "null"]},
        "runtime_or_sdk": {"type": ["string", "null"]},
        "temperature": {"type": ["number", "null"]},
        "top_p": {"type": ["number", "null"]},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "seed": {"type": ["integer", "null"]},
        "retry_policy": {"type": "string", "minLength": 1},
        "ordering_policy": {"type": "string", "minLength": 1}
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_constructor", "generation_operator", "evaluator", "prior_exposure_disclosed"],
      "properties": {
        "case_constructor": {"type": "string", "minLength": 1},
        "generation_operator": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "model_identity_blinded_to_evaluator": {"type": ["boolean", "null"]},
        "condition_blinded_to_evaluator": {"type": ["boolean", "null"]},
        "prior_exposure_disclosed": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "started_at", "completed_at", "status", "request_count_expected", "request_count_recorded", "parse_failure_count", "request_failure_count"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "minLength": 1},
        "completed_at": {"type": ["string", "null"]},
        "status": {"enum": ["planned", "running", "complete-unscored", "scored", "technical-invalid", "invalid"]},
        "request_count_expected": {"type": "integer", "minimum": 1},
        "request_count_recorded": {"type": "integer", "minimum": 0},
        "parse_failure_count": {"type": "integer", "minimum": 0},
        "request_failure_count": {"type": "integer", "minimum": 0},
        "protocol_deviation": {"type": ["boolean", "null"]},
        "protocol_deviation_notes": {"type": ["string", "null"]}
      }
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preregistration", "raw_responses", "run_manifest", "result_report"],
      "properties": {
        "preregistration": {"type": "string", "minLength": 1},
        "raw_responses": {"type": "string", "minLength": 1},
        "run_manifest": {"type": "string", "minLength": 1},
        "confirmatory_scores": {"type": ["string", "null"]},
        "semantic_scores": {"type": ["string", "null"]},
        "exploratory_analysis": {"type": ["string", "null"]},
        "result_report": {"type": "string", "minLength": 1}
      }
    }
  }
}
